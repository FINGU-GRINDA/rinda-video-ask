# ===========================================
# Rinda Video Ask - Widget Build Configuration
# ===========================================
# Copy this file to .env and fill in the values
# These variables are embedded at BUILD TIME

# -------------------------------------------
# API CONFIGURATION
# -------------------------------------------
# The base URL for the Rinda Ask API
# In production, this should point to your deployed studio app
# Default: https://api.rindaask.com
VITE_API_URL=https://api.rindaask.com

# Alternative: Point to your self-hosted instance
# VITE_API_URL=https://your-domain.com

# -------------------------------------------
# BUILD OPTIONS
# -------------------------------------------
# Set to 'development' for debug builds with console logs
# Default in build: 'production' (console logs stripped)
NODE_ENV=production
