# ===========================================
# Rinda Video Ask - Studio Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# -------------------------------------------
# SUPABASE (Required)
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -------------------------------------------
# AI SERVICES (Required for full functionality)
# -------------------------------------------
# OpenAI - Used for Whisper (audio transcription) and embeddings
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic - Used for Claude AI analysis and chat
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Rinda Translation API (Optional - falls back to Claude)
RINDA_API_KEY=

# -------------------------------------------
# OAUTH PROVIDERS (Optional)
# Configure in Supabase Dashboard > Authentication > Providers
# -------------------------------------------
# Naver Login
# Get from: https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Kakao Login
# Get from: https://developers.kakao.com/console/app
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# -------------------------------------------
# INTEGRATIONS (Optional)
# -------------------------------------------
# Clearbit - Company data enrichment for B2B leads
# Get from: https://dashboard.clearbit.com/api
CLEARBIT_API_KEY=

# Slack - High-value lead notifications
# Get from: https://api.slack.com/apps > Incoming Webhooks
SLACK_WEBHOOK_URL=

# KakaoWork - Team notifications (Korean workplace)
KAKAO_WORK_WEBHOOK_URL=

# -------------------------------------------
# WIDGET CONFIGURATION
# -------------------------------------------
# CDN URL where the widget JS is hosted
WIDGET_CDN_URL=https://cdn.rindaask.com

# Public URL of this studio app (for widget API calls)
NEXT_PUBLIC_APP_URL=http://localhost:3002

# -------------------------------------------
# OPTIONAL: Development Settings
# -------------------------------------------
# Set to 'true' to enable demo mode without real backend
# DEMO_MODE=false
